```python
dialogue = DialogueForMultipleSearches(
    searcher="Couch Potato",
    recommender="Life Coach",
    scenario="A couch potato is getting help from a life coach to look for an exercise activity, a routine.",
    topics=[
        SearchTopic(
            searched_item_type_name="Exercise Activity",
            possible_criteria={
                "Intensity": "Low",
                "Duration": "30 minutes",
                "Location": "Home",
                "Equipment": "None",
                "Type": "Cardio"
            }
        )
    ]
)
```
