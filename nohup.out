dialogue = DialogueForMultipleSearches(
    searcher="Assisted Living Manager",
    recommender="Consultant",
    scenario="An assisted living manager is getting help from a consultant to look for a new hire and a new weekly activity for the residents.",
    topics=[
        SearchTopic(
            searched_item_type_name="New Hire",
            possible_criteria={
                "Experience": "2+ years in senior care",
                "Qualifications": "Certified Nursing Assistant",
                "Availability": "Full-time",
                "Skills": "Activity planning and engagement"
            }
        ),
        SearchTopic(
            searched_item_type_name="Weekly Activity",
            possible_criteria={
                "Type": "Physical Activity",
                "Duration": "1 hour",
                "Frequency": "Weekly",
                "Target Group": "Senior residents"
            }
        )
    ]
)
